#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Backend TypeScript validation
echo "\n📦 Checking backend..."
cd backend && npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ Backend TypeScript errors found!"
  exit 1
fi
cd ..

# participant-frontend TypeScript + Lint (warnings allowed)
echo "\n📦 Checking participant-frontend..."
cd participant-frontend && npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ participant-frontend type errors found!"
  exit 1
fi
npm run lint
cd ..

# research-frontend TypeScript + Lint (warnings allowed)
echo "\n📦 Checking research-frontend..."
cd research-frontend && npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ research-frontend type errors found!"
  exit 1
fi
npm run lint
cd ..

echo "\n✅ All checks passed! Proceeding with commit..."
