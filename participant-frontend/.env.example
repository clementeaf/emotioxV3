# ⚠️ API Configuration - IMPORTANT
# DO NOT set VITE_API_URL in .env files!
# Use /public/runtime-config.json instead for dynamic configuration.
# VITE_API_URL=https://your-api-url.com  <- DO NOT UNCOMMENT THIS

# Cloudflare Turnstile Configuration (Anti-Bot Protection)
# Get your site key from: https://dash.cloudflare.com/?to=/:account/turnstile
# For testing (always passes): 1x00000000000000000000AA
# For production: Use your actual site key from Cloudflare dashboard
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
