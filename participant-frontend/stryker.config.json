{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "mutate": [
    "src/lib/eyeTracking/zoneClassifier.ts",
    "src/lib/eyeTracking/hysteresisEngine.ts",
    "src/lib/eyeTracking/zoneEventEmitter.ts",
    "src/lib/eyeTracking/zoneRegistry.ts",
    "src/lib/eyeTracking/v2ResponseBuilder.ts",
    "src/lib/eyeTracking/deviceProfile.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
