# API Configuration
VITE_API_URL=http://localhost:3000

# Participant app origin (optional in local dev).
# In `npm run dev`, research-frontend defaults to http://localhost:12600 (participant Vite port) so labs and links do not use public/runtime-config.json (cPanel).
# Set this to override, e.g. to test against deployed participant: VITE_PARTICIPANT_FRONTEND_URL=https://emotio.cx/participant
# VITE_PARTICIPANT_FRONTEND_URL=http://localhost:12600
