# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/emotiox

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name

# JWT Configuration
JWT_SECRET=your-jwt-secret-key

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
APP_AWS_REGION=us-east-1

# Cloudflare Turnstile Configuration
# Get your secret key from: https://dash.cloudflare.com/?to=/:account/turnstile
# IMPORTANT: Keep this secret! Never commit to version control
# For testing (always passes): 1x0000000000000000000000000000000AA
# For production: Use your actual secret key from Cloudflare dashboard
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Application Environment
NODE_ENV=development

# Trello API Configuration (for MCP Server)
# Get your API key from: https://trello.com/app-key
# Generate token from the same page after getting API key
# Board ID can be found in your Trello board URL: https://trello.com/b/BOARD_ID/board-name
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token
TRELLO_BOARD_ID=your-trello-board-id
