{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "mutate": [
    "src/modules/tracking/tracking-emotion.analytics.ts",
    "src/modules/analytics/eye-tracking.analytics.ts",
    "src/modules/tracking/tracking-gaze-logic.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
