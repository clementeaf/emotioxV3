{
  "CORSRules": [
    {
      "AllowedHeaders": ["*"],
      "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
      "AllowedOrigins": ["*"],
      "ExposeHeaders": [
        "ETag",
        "Content-Type",
        "Content-Length",
        "x-amz-server-side-encryption",
        "x-amz-request-id",
        "x-amz-id-2",
        "x-amz-checksum-crc32",
        "x-amz-sdk-checksum-algorithm"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}
